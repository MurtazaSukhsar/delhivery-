# Copy to .env and fill in. Only VITE_ values reach the browser, and they are public by design.
# Never put the Google key or the Supabase secret key in this file.

# Supabase project: Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (legacy) or publishable key
VITE_SUPABASE_ANON_KEY=

# Must match the PHONE_LOGIN_DOMAIN secret of the api function (drivers log in with phone numbers)
VITE_PHONE_LOGIN_DOMAIN=phone.delivery.local

# Optional: only if the API is not at  <VITE_SUPABASE_URL>/functions/v1/api
# VITE_API_URL=

# Optional: path prefix when hosting the app under a sub-folder, e.g. /delivery/
# VITE_BASE=/
