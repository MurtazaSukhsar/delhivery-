# Secrets for the "api" Edge Function. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# (copy this file to supabase/functions/.env first; that file is git-ignored)
# SUPABASE_URL and the Supabase secret key are provided to the function automatically.

# Whole JSON key of the Google service account, on one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"delivery-api@YOUR-PROJECT.iam.gserviceaccount.com"}

# ID of the platform spreadsheet (the long part of its URL between /d/ and /edit)
PLATFORM_SHEET_ID=

# Comma-separated emails of platform admins (Farwings). They see every organisation.
SUPER_ADMIN_EMAILS=you@farwings.example

# Drivers sign in with a phone number; it is stored in Supabase as <digits>@<this domain>.
# Keep it the same as VITE_PHONE_LOGIN_DOMAIN in the frontend .env and never change it after drivers exist.
PHONE_LOGIN_DOMAIN=phone.delivery.local
